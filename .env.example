# Local dev uses docker-compose service names; override for cloud.
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017
MONGO_DB=gymjam
PORT=3000
IDEM_TTL=86400   # idempotency-key retention, seconds
FLUSH_MS=500     # Redis -> Mongo flush interval (durability trade-off)

# --- QR / join URL --------------------------------------------------------------
# Optional deploy-time override of the URL phones should open.
# Beaten by the per-gym URL the operator types into the UI (top priority).
# Leave blank in production behind ALB/API Gateway — the Host header is right.
PUBLIC_URL=

# Optional: enables type-to-search when adding songs (YouTube Data API v3).
# Leave blank and members add songs by pasting a YouTube link (no key, no quota).
YOUTUBE_API_KEY=

# --- Step 4: ML recommender ----------------------------------------------------
# URL of the implicit-ALS scoring service (Flask in ml/, or a SageMaker endpoint
# fronted by a SigV4-signing proxy). Blank = recommender disabled, room runs on
# votes only — fully backward-compatible with Step 3.
RECOMMENDER_URL=
RECOMMENDER_TIMEOUT_MS=1500     # per-call timeout; circuit breaker after 3 failures
RECOMMENDER_CACHE_TTL_MS=30000  # how long a per-gym score cache stays warm
RECOMMENDER_REFRESH_MS=30000    # background warmer cadence
